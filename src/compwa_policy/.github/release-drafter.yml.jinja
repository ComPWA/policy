name-template: "{{ REPO_TITLE }} $NEXT_PATCH_VERSION"
tag-template: "{{ TAG_PREFIX }}$NEXT_PATCH_VERSION"

references:
  - main
  - epic/*

categories:
  - title: ✨ New features
    label: ✨ Feature
  - title: ⚠️ Enhancements and optimizations
    label: ⚙️ Enhancement
  - title: ⚠️ API changes
    label: ⚠️ Interface
  - title: ⚠️ Changes that may affect behavior
    label: ❗ Behavior
  - title: 🐛 Bug fixes
    label: 🐛 Bug
  - title: 📝 Documentation
    label: 📝 Docs
  - title: 🔨 Maintenance
    labels:
      - 🔨 Maintenance
      - ⬆️ Lock
  - title: 🖱️ Developer Experience
    label: 🖱️ DX

change-template: "- $TITLE (#$NUMBER)"

replacers:
  - search: /([A-Z]+!?:\s*)(.*)/g
    replace: $2

sort-direction: ascending

template: |
  {% if HAS_READTHEDOCS -%}
  _See all documentation for this version [here](https://{{ REPO_NAME }}.rtfd.io/en/$NEXT_PATCH_VERSION)._

  {% endif -%}
  $CHANGES

  _The full changelog as commits can be found [here](https://github.com/{{ ORGANIZATION }}/{{ REPO_NAME }}/compare/$PREVIOUS_TAG...{{ TAG_PREFIX }}$NEXT_PATCH_VERSION)._
