{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["redeboer"],
  "commitMessageAction": "update",
  "commitMessageLowerCase": "never",
  "dependencyDashboard": false,
  "enabledManagers": ["github-actions"],
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "ignorePaths": [
    // Symlinks to .github/workflows/, where Dependabot updates the actions.
    "src/compwa_policy/.github/workflows/clean-caches.yml",
    "src/compwa_policy/.github/workflows/pr-linting.yml",
    "src/compwa_policy/.github/workflows/release-drafter.yml"
  ],
  "includePaths": ["src/compwa_policy/.github/workflows/**"],
  "labels": ["⬆️ Lock"],
  "packageRules": [
    {
      "description": "Group updates of the GitHub Actions in the workflow templates",
      "groupName": "GitHub Actions in workflow templates",
      "matchManagers": ["github-actions"]
    }
  ],
  "pinDigest": {
    "commitMessageAction": "pin"
  },
  "reviewers": ["redeboer"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "",
  "semanticCommitType": "MAINT"
}
